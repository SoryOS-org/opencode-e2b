{
  "name": "opencode-e2b-workspace-plugin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "E2B sandboxes for OpenCode: workspaces for OpenCode 1, sandboxed shell commands for OpenCode 2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "opencode": ">=1.16.0",
    "bun": ">=1.3.0"
  },
  "files": [
    "dist",
    "bin",
    "index.js"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && bun test test/*.test.ts",
    "prepack": "bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.23",
    "e2b": "2.56.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.0",
    "@types/bun": "^1.3.13",
    "@types/node": "24.5.2",
    "prettier": "^3.8.3",
    "typescript": "5.9.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
