{
  "name": "opencode-e2b-workspace-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode workspace plugin for provisioning E2B sandboxes",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "opencode": ">=1.17.11",
    "bun": ">=1.3.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && bun test test/*.test.mjs",
    "prepack": "bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.17.11",
    "e2b": "2.30.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "24.5.2",
    "prettier": "^3.8.3",
    "typescript": "5.9.2"
  }
}
